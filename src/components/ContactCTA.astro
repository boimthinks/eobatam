---
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Rencanakan Event Perusahaan Anda Tanpa Repot",
  subtitle = "Tim EO Batam Production siap datang langsung ke kantor Anda di Batam untuk presentasi proposal, bedah konsep, dan penyusunan RAB transparan tanpa dipungut biaya."
} = Astro.props;
---

<section class="py-16 bg-[#002366] text-white relative overflow-hidden bg-grid-blueprint-dark border-y-2 border-[#00d4ff]/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="bg-[#001845] border border-[#00d4ff]/40 rounded-xl p-8 sm:p-12 shadow-xl">
      <div class="max-w-3xl mx-auto text-center space-y-6">
        
        <!-- Monospace Tag -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded bg-white/10 border border-[#00d4ff]/40 text-xs font-mono text-[#00d4ff] uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-[#00d4ff]"></span>
          <span>LAYANAN FREE ON-SITE CONSULTATION & SURVEY</span>
        </div>

        <h2 class="text-2xl sm:text-4xl font-bold font-sans tracking-tight text-white leading-tight">
          {title}
        </h2>

        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          {subtitle}
        </p>

        <!-- Position Counters Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-6 pb-4 text-left">
          <div class="p-3 bg-white/5 border border-white/10 rounded">
            <span class="block font-mono text-[#00d4ff] text-xs font-bold mb-1">01 / SURVEI</span>
            <span class="text-xs text-slate-200">Kunjungan kantor / venue gratis di Batam</span>
          </div>
          <div class="p-3 bg-white/5 border border-white/10 rounded">
            <span class="block font-mono text-[#00d4ff] text-xs font-bold mb-1">02 / PROPOSAL</span>
            <span class="text-xs text-slate-200">Konsep tematik & rundown detail</span>
          </div>
          <div class="p-3 bg-white/5 border border-white/10 rounded">
            <span class="block font-mono text-[#00d4ff] text-xs font-bold mb-1">03 / RAB</span>
            <span class="text-xs text-slate-200">Transparansi anggaran sesuai budget</span>
          </div>
          <div class="p-3 bg-white/5 border border-white/10 rounded">
            <span class="block font-mono text-[#00d4ff] text-xs font-bold mb-1">04 / LEGALITAS</span>
            <span class="text-xs text-slate-200">Pengurusan izin Polresta Barelang</span>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
          <a
            href="https://wa.me/6281373703639?text=Halo%20EO%20Batam%20Production,%20kami%20ingin%20mengundang%20tim%20Anda%20ke%20kantor%20untuk%20konsultasi%20event"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto font-mono text-sm uppercase font-bold px-8 py-4 rounded bg-[#00d4ff] text-[#001845] hover:bg-white hover:text-[#002366] transition-all shadow-md flex items-center justify-center gap-3"
          >
            <span>Undang Tim ke Kantor (WhatsApp)</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <a
            href="tel:+6281373703639"
            class="w-full sm:w-auto font-mono text-sm uppercase font-bold px-6 py-4 rounded bg-white/10 text-white border border-white/20 hover:bg-white/20 transition-all flex items-center justify-center gap-2"
          >
            <span>Hubungi: 0813-7370-3639</span>
          </a>
        </div>

        <p class="text-[11px] font-mono text-slate-400">
          Kantor: Komp. Ruko Mega Legenda 2 Blok B2 No.7, Baloi Permai, Batam Kota
        </p>

      </div>
    </div>
  </div>
</section>
