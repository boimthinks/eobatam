---
interface Props {
  class?: string;
  size?: number;
}

const { class: className = 'w-11 h-11', size = 44 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  width={size}
  height={size}
  class={className}
  fill="none"
  role="img"
  aria-label="EO Batam Production Logo"
>
  <defs>
    <linearGradient id="eoLogoCyan" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00d4ff"></stop>
      <stop offset="100%" stop-color="#0088cc"></stop>
    </linearGradient>
  </defs>

  <!-- Shield / Badge Base -->
  <path
    d="M32 3 L55 16 V38 C55 48 44 56 32 61 C20 56 9 48 9 38 V16 Z"
    fill="#001845"
    stroke="url(#eoLogoCyan)"
    stroke-width="2.4"
    stroke-linejoin="round"></path>

  <!-- Inner Stage Truss Hexagon -->
  <path
    d="M32 12 L46 21 V36 L32 45 L18 36 V21 Z"
    stroke="#00d4ff"
    stroke-width="1.4"
    stroke-linejoin="round"
    fill="rgba(0, 212, 255, 0.08)"></path>

  <!-- Monogram E -->
  <path
    d="M23 24 H31 M23 30 H29 M23 36 H31 M23 24 V36"
    stroke="#FFFFFF"
    stroke-width="2.6"
    stroke-linecap="round"
    stroke-linejoin="round"></path>

  <!-- Monogram O with center beacon -->
  <circle cx="39.5" cy="30" r="5.2" stroke="#00d4ff" stroke-width="2.4" fill="none"></circle>
  <circle cx="39.5" cy="30" r="1.6" fill="#FFFFFF"></circle>

  <!-- Foundation / Stage Arc -->
  <path
    d="M21 52 C27 50, 37 50, 43 52"
    stroke="#00d4ff"
    stroke-width="1.8"
    stroke-linecap="round"></path>
</svg>