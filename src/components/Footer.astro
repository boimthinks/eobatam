---
import GoogleSourcePreferences from './GoogleSourcePreferences.astro';
import Logo from './Logo.astro';

const services = [
  { name: 'Jasa Event Organizer Batam', href: '/layanan/' },
  { name: 'Corporate Gathering Batam', href: '/layanan/corporate-gathering-batam/' },
  { name: 'MICE & Seminar Bisnis', href: '/layanan/mice-event-organizer-batam/' },
  { name: 'Outbound & Team Building', href: '/layanan/outbound-team-building-batam/' },
  { name: 'Gala Dinner & Awarding Night', href: '/layanan/gala-dinner-awarding-batam/' },
];

const quickLinks = [
  { name: 'Beranda', href: '/' },
  { name: 'Semua Layanan', href: '/layanan/' },
  { name: 'Tentang Kami', href: '/tentang-kami/' },
  { name: 'Profil Penulis', href: '/author/zazuli/' },
  { name: 'Artikel & Panduan', href: '/blog/' },
  { name: 'Kontak Langsung', href: '/kontak/' },
];
---

<footer class="bg-[#001845] text-white border-t-2 border-[#00d4ff] pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- 4-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 pb-14 border-b border-white/10">
      
      <!-- Col 1: Identity & Scope -->
      <div class="space-y-4">
        <a href="/" class="flex items-center gap-3 group inline-flex">
          <Logo class="w-9 h-9 group-hover:scale-105 transition-transform drop-shadow-[0_2px_6px_rgba(0,212,255,0.3)]" />
          <span class="font-mono font-bold text-base tracking-wider text-white group-hover:text-[#00d4ff] transition-colors">
            EO BATAM PRODUCTION
          </span>
        </a>
        <p class="text-xs font-mono text-[#00d4ff] uppercase tracking-wide">
          Event Organizer All-in-One Terpercaya di Batam
        </p>
        <p class="text-sm text-slate-300 leading-relaxed">
          Mitra strategis korporasi, BUMN, dan instansi untuk penyelenggaraan corporate gathering, seminar MICE, outbound pantai, dan gala dinner berstandar profesional di Kota Batam.
        </p>
        <div class="pt-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-white/10 text-[11px] font-mono text-slate-200">
            <span class="w-1.5 h-1.5 rounded-full bg-[#00d4ff]"></span>
            AREA: SELURUH KOTA BATAM
          </span>
        </div>
      </div>

      <!-- Col 2: Services -->
      <div>
        <h3 class="font-mono text-xs uppercase text-[#00d4ff] tracking-widest font-bold mb-5 pb-1 border-b border-white/10">
          LAYANAN UTAMA
        </h3>
        <ul class="space-y-2.5 text-sm text-slate-300">
          {services.map((item) => (
            <li>
              <a href={item.href} class="hover:text-[#00d4ff] hover:underline flex items-center gap-2 transition-colors">
                <span class="text-[#00d4ff] font-mono text-xs">›</span>
                <span>{item.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Navigation -->
      <div>
        <h3 class="font-mono text-xs uppercase text-[#00d4ff] tracking-widest font-bold mb-5 pb-1 border-b border-white/10">
          NAVIGASI WEBSITE
        </h3>
        <ul class="space-y-2.5 text-sm text-slate-300 font-mono text-xs">
          {quickLinks.map((item) => (
            <li>
              <a href={item.href} class="hover:text-[#00d4ff] transition-colors flex items-center gap-2">
                <span class="text-white/40">#</span>
                <span>{item.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Contact & Position Counters -->
      <div>
        <h3 class="font-mono text-xs uppercase text-[#00d4ff] tracking-widest font-bold mb-5 pb-1 border-b border-white/10">
          PUSAT OPERASIONAL
        </h3>
        <div class="space-y-4 text-xs font-mono">
          <!-- Counter 01: Address -->
          <div class="flex items-start gap-3">
            <div class="w-6 h-6 rounded bg-[#00d4ff] text-[#001845] font-bold text-[10px] flex items-center justify-center shrink-0">
              01
            </div>
            <div class="text-slate-300 leading-snug">
              <span class="block text-white font-bold mb-0.5">KANTOR UTAMA:</span>
              Ruko Mega Legenda 2 Blok B2 No.7, Baloi Permai, Batam Kota, Batam 29431
            </div>
          </div>

          <!-- Counter 02: WhatsApp -->
          <div class="flex items-start gap-3">
            <div class="w-6 h-6 rounded bg-[#00d4ff] text-[#001845] font-bold text-[10px] flex items-center justify-center shrink-0">
              02
            </div>
            <div class="text-slate-300 leading-snug">
              <span class="block text-white font-bold mb-0.5">WHATSAPP / KONSULTASI:</span>
              <a href="https://wa.me/6281373703639" target="_blank" rel="noopener noreferrer" class="text-[#00d4ff] hover:underline">
                0813-7370-3639
              </a>
            </div>
          </div>

          <!-- Counter 03: Email -->
          <div class="flex items-start gap-3">
            <div class="w-6 h-6 rounded bg-[#00d4ff] text-[#001845] font-bold text-[10px] flex items-center justify-center shrink-0">
              03
            </div>
            <div class="text-slate-300 leading-snug">
              <span class="block text-white font-bold mb-0.5">EMAIL RESMI:</span>
              <a href="mailto:info@eobatam.web.id" class="text-slate-300 hover:text-[#00d4ff]">
                info@eobatam.web.id
              </a>
            </div>
          </div>

          <!-- Counter 04: Jam Operasional -->
          <div class="flex items-start gap-3">
            <div class="w-6 h-6 rounded bg-[#00d4ff] text-[#001845] font-bold text-[10px] flex items-center justify-center shrink-0">
              04
            </div>
            <div class="text-slate-300 leading-snug">
              <span class="block text-white font-bold mb-0.5">JAM KERJA:</span>
              Senin sampai Sabtu, 08.30 sampai 17.30 WIB<br/>
              (Standby Event 24 Jam)
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Google Source Preferences Banner -->
    <div class="py-6 border-b border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-xs text-slate-300 font-sans text-center sm:text-left">
        <span class="text-[#00d4ff] font-mono font-bold block mb-0.5">SUMBER PREFERENSI GOOGLE</span>
        Simpan referensi penyelenggara event terpercaya di Batam langsung ke akun Google Anda.
      </div>
      <div class="w-full sm:w-auto shrink-0">
        <GoogleSourcePreferences class="my-0" />
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-mono text-slate-400">
      <div>
        &copy; {new Date().getFullYear()} EO Batam Production (eobatam.web.id). All rights reserved.
      </div>
      <div>
        <span>Kota Batam, Kepri</span>
      </div>
    </div>
  </div>
</footer>
