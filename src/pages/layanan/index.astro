---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { servicesData } from '../../data/services';
---

<BaseLayout
  title="Layanan Event Organizer Batam - EO Batam Production"
  description="Daftar lengkap layanan EO Batam: Corporate Gathering, MICE & Seminar Bisnis, Outbound Pantai, dan Gala Dinner Perusahaan di Kota Batam."
  image="/images/pages/layanan-default.webp"
>
  <Breadcrumbs items={[{ name: 'Layanan' }]} />

  <!-- Page Header -->
  <section class="py-16 bg-[#002366] text-white bg-grid-blueprint-dark border-b-2 border-[#00d4ff]/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <span class="inline-block px-3 py-1 bg-white/10 text-[#00d4ff] font-mono text-xs uppercase tracking-wider rounded border border-[#00d4ff]/40">
          KATALOG LAYANAN TERPADU
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight font-sans text-white">
          Layanan Event Organizer Profesional di Batam
        </h1>
        <p class="text-slate-200 text-sm sm:text-base leading-relaxed">
          Kami memfokuskan keahlian pada empat pilar event korporasi dan instansi. Tanpa rental alat eceran yang memecah perhatian, seluruh sumber daya dan perlengkapan kami curahkan untuk kesuksesan event Anda.
        </p>
      </div>
    </div>
  </section>

  <!-- Service List Section -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      {servicesData.map((svc) => (
        <div class="bg-white border-2 border-slate-200 rounded-lg p-8 sm:p-10 shadow-sm hover:border-[#002366] transition-all">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <div class="lg:col-span-8 space-y-4">
              <div class="flex items-center gap-3">
                <span class="w-9 h-9 rounded bg-[#002366] text-white font-mono font-bold text-sm flex items-center justify-center">
                  {svc.counter}
                </span>
                <span class="font-mono text-xs font-semibold px-2.5 py-1 bg-blue-50 text-[#002366] rounded border border-blue-200">
                  {svc.priceRange}
                </span>
              </div>

              <h2 class="text-2xl sm:text-3xl font-bold text-[#002366]">
                <a href={`/layanan/${svc.slug}/`} class="hover:underline">
                  {svc.title}
                </a>
              </h2>

              <p class="font-mono text-xs text-[#0c3d9c] font-semibold uppercase">
                {svc.tagline}
              </p>

              <p class="text-sm text-slate-600 leading-relaxed">
                {svc.description}
              </p>

              <!-- Inclusions -->
              <div class="pt-4 border-t border-slate-100">
                <span class="block font-mono text-xs font-bold text-slate-700 uppercase mb-2">
                  Paket Sudah Termasuk:
                </span>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-600">
                  {svc.included.map((item) => (
                    <div class="flex items-center gap-2">
                      <svg class="w-3.5 h-3.5 text-[#002366] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                      </svg>
                      <span>{item}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <div class="lg:col-span-4 space-y-4">
              <!-- 4:3 Aspect Ratio Image -->
              <a href={`/layanan/${svc.slug}/`} class="block aspect-[4/3] w-full rounded-lg overflow-hidden border border-slate-200 bg-slate-100 shadow-sm relative group">
                <img
                  src={svc.image}
                  alt={svc.title}
                  width="800"
                  height="600"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </a>

              <div class="bg-slate-50 p-6 rounded-lg border border-slate-200 space-y-4">
                <div>
                  <span class="font-mono text-[11px] font-bold text-slate-500 uppercase block mb-1">
                    REKOMENDASI VENUE BATAM:
                  </span>
                  <ul class="text-xs text-slate-700 space-y-1">
                    {svc.venues.map((v) => (
                      <li class="flex items-center gap-1.5">
                        <span class="text-[#002366]">•</span>
                        <span>{v}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="pt-4 border-t border-slate-200 space-y-2">
                  <a
                    href={`/layanan/${svc.slug}/`}
                    class="block text-center font-mono text-xs uppercase font-bold py-2.5 px-4 rounded bg-[#002366] text-white hover:bg-[#0c3d9c] transition-colors"
                  >
                    Lihat Rincian Layanan
                  </a>
                  <a
                    href={`https://wa.me/6281373703639?text=Halo%20EO%20Batam,%20saya%20tertarik%20dengan%20layanan%20${encodeURIComponent(svc.shortTitle)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block text-center font-mono text-xs uppercase font-bold py-2.5 px-4 rounded bg-[#00d4ff] text-[#001845] hover:bg-[#00bce3] transition-colors"
                  >
                    Konsultasi via WA
                  </a>
                </div>
              </div>
            </div>

          </div>
        </div>
      ))}

    </div>
  </section>

  <ContactCTA />
</BaseLayout>
