---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const popularLinks = [
  { name: 'Corporate Gathering Batam', href: '/layanan/corporate-gathering-batam/', code: '01' },
  { name: 'MICE & Seminar Bisnis', href: '/layanan/mice-event-organizer-batam/', code: '02' },
  { name: 'Outbound & Team Building Pantai', href: '/layanan/outbound-team-building-batam/', code: '03' },
  { name: 'Gala Dinner & Awarding Night', href: '/layanan/gala-dinner-awarding-batam/', code: '04' },
  { name: 'Artikel & Panduan Event', href: '/blog/', code: 'KB' },
  { name: 'Kontak Langsung EO Batam', href: '/kontak/', code: 'CS' },
];
---

<BaseLayout
  title="404 - Halaman Tidak Ditemukan | EO Batam Production"
  description="Halaman yang Anda cari tidak ditemukan atau telah dipindahkan. Kembali ke beranda EO Batam Production untuk melihat layanan corporate gathering, MICE, outbound, dan gala dinner di Batam."
  noindex={true}
>
  <Breadcrumbs items={[{ name: '404 - Halaman Tidak Ditemukan' }]} />

  <!-- Hero Notice 404 -->
  <section class="py-16 sm:py-24 bg-[#002366] text-white bg-grid-blueprint-dark border-b-4 border-[#00d4ff] relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded bg-white/10 border border-[#00d4ff]/40 text-xs font-mono text-[#00d4ff] uppercase tracking-wider mb-6">
        <span class="w-2 h-2 rounded-full bg-[#00d4ff] animate-ping"></span>
        <span>ERROR 404 • STATUS TAUTAN TIDAK DITEMUKAN</span>
      </div>

      <!-- Large Error Code -->
      <div class="font-mono text-7xl sm:text-9xl font-black text-transparent bg-clip-text bg-gradient-to-b from-[#00d4ff] to-[#002366]/40 tracking-tight leading-none mb-4 select-none drop-shadow-[0_4px_20px_rgba(0,212,255,0.25)]">
        404
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight font-sans text-white max-w-2xl mx-auto mb-4">
        Halaman yang Anda Tuju Tidak Ditemukan
      </h1>

      <p class="text-slate-200 text-sm sm:text-base leading-relaxed max-w-2xl mx-auto mb-8 font-sans">
        Alamat tautan mungkin telah dipindahkan, berganti struktur URL, atau salah ketik. Tim EO Batam Production siap membantu Anda menemukan informasi yang diperlukan.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto">
        <a
          href="/"
          class="w-full sm:w-auto font-mono text-xs uppercase font-bold px-6 py-3.5 rounded bg-[#00d4ff] text-[#001845] hover:bg-white hover:text-[#002366] transition-all shadow-md flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span>Kembali ke Beranda</span>
        </a>

        <a
          href="https://wa.me/6281373703639?text=Halo%20EO%20Batam%20Production,%20saya%20mengalami%20kendala%20saat%20mengakses%20halaman%20website"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto font-mono text-xs uppercase font-bold px-6 py-3.5 rounded bg-white/10 text-white border border-white/20 hover:bg-white/20 transition-all flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4 text-[#00d4ff]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
          <span>Bantuan via WhatsApp</span>
        </a>
      </div>

    </div>
  </section>

  <!-- Popular Destination Silos -->
  <section class="py-16 sm:py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mb-10 text-center sm:text-left">
        <div class="font-mono text-xs uppercase text-[#002366] font-bold tracking-widest mb-2 flex items-center justify-center sm:justify-start gap-2">
          <span class="w-6 h-0.5 bg-[#002366]"></span>
          <span>NAVIGASI PILIHAN POPULER</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#002366] tracking-tight">
          Halaman Utama yang Sering Dikunjungi
        </h2>
        <p class="text-slate-600 mt-2 text-xs sm:text-sm leading-relaxed">
          Silakan pilih tautan layanan, panduan event korporasi, atau hubungi tim operasional kami di Batam:
        </p>
      </div>

      <!-- Links Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        {popularLinks.map((item) => (
          <a
            href={item.href}
            class="bg-white border-2 border-slate-200 hover:border-[#002366] hover:shadow-md transition-all p-5 rounded-lg flex items-center justify-between group"
          >
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded bg-[#002366] text-[#00d4ff] font-mono font-bold text-xs flex items-center justify-center flex-shrink-0 group-hover:bg-[#00d4ff] group-hover:text-[#001845] transition-colors">
                {item.code}
              </span>
              <span class="text-xs sm:text-sm font-bold text-[#002366] group-hover:text-[#0c3d9c] transition-colors">
                {item.name}
              </span>
            </div>
            <svg class="w-4 h-4 text-slate-400 group-hover:text-[#002366] group-hover:translate-x-1 transition-all flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        ))}
      </div>

      <!-- Help Box: Direct Visit Offer -->
      <div class="mt-12 p-6 sm:p-8 bg-white border-2 border-[#002366]/20 rounded-xl shadow-sm flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-1 text-center md:text-left">
          <span class="text-[11px] font-mono font-bold uppercase text-[#0c3d9c] block">
            KEMUDAHAN KONSULTASI KORPORASI BATAM
          </span>
          <h3 class="text-base sm:text-lg font-bold text-[#002366]">
            Perlu Presentasi Proposal atau Diskusi RAB Langsung?
          </h3>
          <p class="text-xs text-slate-600">
            Tim konsultan EO Batam Production siap datang langsung ke kantor perusahaan Anda di seluruh area Kota Batam tanpa biaya awal.
          </p>
        </div>
        <a
          href="https://wa.me/6281373703639?text=Halo%20EO%20Batam%20Production,%20kami%20ingin%20mengundang%20tim%20Anda%20ke%20kantor%20untuk%20konsultasi%20event"
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 font-mono text-xs uppercase font-bold px-6 py-3 rounded bg-[#002366] text-[#00d4ff] hover:bg-[#001845] hover:text-white transition-all shadow-sm flex items-center gap-2"
        >
          <span>Undang Tim ke Kantor</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

    </div>
  </section>
</BaseLayout>
