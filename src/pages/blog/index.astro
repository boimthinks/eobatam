---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const publishedPosts = posts
  .filter((post) => !post.data.draft || import.meta.env.DEV)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<BaseLayout
  title="Panduan & Artikel Event Organizer Batam - EO Batam Production"
  description="Kumpulan panduan praktis, estimasi RAB event, regulasi izin keramaian Polresta Barelang, dan tips memilih venue gathering di Kota Batam."
>
  <Breadcrumbs items={[{ name: 'Blog' }]} />

  <!-- Page Header -->
  <section class="py-16 bg-[#002366] text-white bg-grid-blueprint-dark border-b-2 border-[#00d4ff]/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <span class="inline-block px-3 py-1 bg-white/10 text-[#00d4ff] font-mono text-xs uppercase tracking-wider rounded border border-[#00d4ff]/40">
          KNOWLEDGE BASE & EVENT INSIGHTS
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight font-sans text-white">
          Artikel & Panduan Penyelenggaraan Event di Batam
        </h1>
        <p class="text-slate-200 text-sm sm:text-base leading-relaxed">
          Panduan praktis dan terpercaya seputar perhitungan RAB event, regulasi perizinan kepolisian, serta rekomendasi teknis pelaksanaan event korporasi di Batam.
        </p>
      </div>
    </div>
  </section>

  <!-- Article Grid -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {publishedPosts.map((post) => (
          <article class="bg-white border-2 border-slate-200 rounded-lg overflow-hidden flex flex-col justify-between hover:border-[#002366] hover:shadow-md transition-all">
            <!-- 4:3 Aspect Ratio Image Container -->
            <a href={`/blog/${post.id}/`} class="block aspect-[4/3] w-full overflow-hidden bg-slate-100 relative group">
              <img
                src={post.data.image || '/images/blog/default-blog.webp'}
                alt={post.data.title}
                width="800"
                height="600"
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
              <span class="absolute top-3 left-3 px-2.5 py-1 rounded bg-[#001845]/90 text-[#00d4ff] text-[11px] font-mono uppercase font-bold backdrop-blur-sm border border-[#00d4ff]/40">
                {post.data.category}
              </span>
            </a>

            <div class="p-6 space-y-3 flex-grow flex flex-col">
              <div class="flex items-center justify-between text-xs font-mono text-slate-400">
                <span>{post.data.publishDate.toISOString().split('T')[0]}</span>
                <a href="/author/zazuli/" class="hover:text-[#002366] hover:underline">{post.data.author}</a>
              </div>

              <h2 class="text-base sm:text-lg font-bold text-[#002366] leading-snug line-clamp-2">
                <a href={`/blog/${post.id}/`} class="hover:underline">
                  {post.data.title}
                </a>
              </h2>

              <p class="text-xs text-slate-600 leading-relaxed line-clamp-3 mt-auto">
                {post.data.description}
              </p>
            </div>

            <div class="px-6 py-3.5 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-xs font-mono">
              <span class="text-slate-500">
                Area: Batam
              </span>
              <a
                href={`/blog/${post.id}/`}
                class="font-bold text-[#002366] hover:text-[#00d4ff] flex items-center gap-1"
              >
                <span>Baca Panduan</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>
