---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { servicesData } from '../data/services';
import { getCollection } from 'astro:content';

const blogPosts = await getCollection('blog');
const sortedPosts = blogPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);
---

<BaseLayout
  title="EO Batam - Jasa Event Organizer All-in-One Terpercaya di Batam"
  description="Jasa Event Organizer (EO) Batam all-in-one terpercaya untuk corporate gathering, MICE, seminar, outbound pantai, dan gala dinner. Konsultasi & survey gratis ke kantor Anda."
  image="/images/og-default.png"
>
  <!-- Hero Section -->
  <section class="relative bg-[#002366] text-white overflow-hidden bg-grid-blueprint-dark border-b-4 border-[#00d4ff]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left: Headline & CTA -->
        <div class="lg:col-span-7 space-y-6">
          <!-- Industrial Label Badge -->
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded bg-white/10 border border-[#00d4ff]/40 text-xs font-mono text-[#00d4ff] uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-[#00d4ff] animate-ping"></span>
            <span>EVENT MANAGEMENT & PRODUKSI TERPADU KOTA BATAM</span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight font-sans leading-tight text-white">
            Jasa Event Organizer All-in-One Terpercaya di Batam
          </h1>

          <p class="text-base sm:text-xl text-slate-200 leading-relaxed">
            Mitra profesional untuk corporate gathering, perhelatan MICE, outbound team building pantai, dan malam penganugerahan gala dinner. Seluruh kebutuhan konsep, perizinan kepolisian, konsumsi, hingga panggung kami kelola dalam satu pintu.
          </p>

          <!-- Unique Selling Proposition Pill -->
          <div class="p-4 bg-[#001845] border-l-4 border-[#00d4ff] rounded-r text-sm text-slate-300 font-mono">
            <span class="text-white font-bold block mb-1">KEMUDAHAN KONSULTASI KORPORASI:</span>
            Tim konsultan EO Batam Production siap datang langsung ke kantor perusahaan Anda di seluruh wilayah Batam untuk presentasi konsep, survey venue, dan penyusunan RAB tanpa biaya awal.
          </div>

          <!-- Hero Buttons -->
          <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <a
              href="https://wa.me/6281373703639?text=Halo%20EO%20Batam%20Production,%20saya%20ingin%20mengundang%20tim%20Anda%20ke%20kantor%20untuk%20konsultasi%20event"
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-sm uppercase font-bold px-8 py-4 rounded bg-[#00d4ff] text-[#001845] hover:bg-white hover:text-[#002366] transition-all shadow-lg flex items-center justify-center gap-3 text-center"
            >
              <span>Undang Tim ke Kantor (WhatsApp)</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>

            <a
              href="#layanan"
              class="font-mono text-sm uppercase font-bold px-6 py-4 rounded bg-white/10 text-white border border-white/20 hover:bg-white/20 transition-all text-center"
            >
              Pelajari 4 Layanan Utama
            </a>
          </div>
        </div>

        <!-- Right: 4:3 Hero Image Card -->
        <div class="lg:col-span-5">
          <div class="aspect-[4/3] w-full rounded-2xl overflow-hidden border-2 border-[#00d4ff]/40 shadow-2xl relative bg-slate-900 group">
            <img
              src="/images/pages/hero-home.webp"
              alt="EO Batam Production - Event Organizer All-in-One Terpercaya di Batam"
              width="800"
              height="600"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="eager"
            />
          </div>
        </div>

      </div>
    </div>

    <!-- Technical Trust Bar -->
    <div class="bg-[#001845]/90 border-t border-white/10 py-5">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-xs font-mono text-slate-300">
          <div class="flex items-center gap-2">
            <span class="text-[#00d4ff] font-bold">01/</span>
            <span>KONSULTASI DI KANTOR KLIEN</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[#00d4ff] font-bold">02/</span>
            <span>MANAJEMEN ALL-IN-ONE</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[#00d4ff] font-bold">03/</span>
            <span>RAB TRANSPARAN & FLEKSIBEL</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[#00d4ff] font-bold">04/</span>
            <span>PENGURUSAN IZIN RESMI POLRESTA</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Layanan Utama (Core Services) -->
  <section id="layanan" class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mb-14">
        <div class="font-mono text-xs uppercase text-[#002366] font-bold tracking-widest mb-2 flex items-center gap-2">
          <span class="w-6 h-0.5 bg-[#002366]"></span>
          <span>4 PILAR LAYANAN UTAMA</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#002366] tracking-tight">
          Solusi Jasa Event Organizer Profesional di Batam
        </h2>
        <p class="text-slate-600 mt-3 text-base leading-relaxed">
          Kami menyediakan manajemen terpadu yang memadukan kreativitas konsep, tata kelola logistik kepulauan, dan ketepatan eksekusi teknis lapangan.
        </p>
      </div>

      <!-- Services Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {servicesData.map((svc) => (
          <div class="bg-white border-2 border-slate-200 rounded-xl overflow-hidden shadow-sm hover:shadow-xl hover:border-[#002366] transition-all flex flex-col justify-between group">
            <div>
              <!-- 4:3 Service Image -->
              <a href={`/layanan/${svc.slug}/`} class="block aspect-[4/3] w-full overflow-hidden bg-slate-100 relative">
                <img
                  src={svc.image}
                  alt={svc.title}
                  width="800"
                  height="600"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-80 group-hover:opacity-60 transition-opacity"></div>
                <div class="absolute top-4 left-4 right-4 flex items-center justify-between">
                  <span class="w-10 h-10 rounded bg-[#002366] text-[#00d4ff] font-mono font-bold text-sm flex items-center justify-center shadow-lg border border-[#00d4ff]/30">
                    {svc.counter}
                  </span>
                  <span class="font-mono text-xs font-bold px-3 py-1 bg-white/95 text-[#002366] rounded-full shadow-md backdrop-blur-sm border border-slate-200">
                    {svc.priceRange}
                  </span>
                </div>
                <div class="absolute bottom-3 left-4 right-4 text-xs font-mono text-slate-200 flex items-center gap-1.5 truncate">
                  <svg class="w-3.5 h-3.5 text-[#00d4ff] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                  <span>Venue: {svc.venues[0]}</span>
                </div>
              </a>

              <div class="p-6 sm:p-8">
                <h3 class="text-xl sm:text-2xl font-bold text-[#002366] mb-2 group-hover:text-[#0c3d9c] transition-colors">
                  <a href={`/layanan/${svc.slug}/`}>{svc.shortTitle}</a>
                </h3>

                <p class="text-xs font-mono text-[#0c3d9c] font-semibold uppercase mb-3">
                  {svc.tagline}
                </p>

                <p class="text-sm text-slate-600 leading-relaxed mb-6">
                  {svc.description}
                </p>

                <!-- Features List -->
                <div class="space-y-2 mb-2">
                  <span class="block font-mono text-[11px] font-bold text-slate-700 uppercase tracking-wider">
                    Cakupan Fasilitas:
                  </span>
                  <ul class="text-xs text-slate-600 space-y-1.5">
                    {svc.features.slice(0, 3).map((f) => (
                      <li class="flex items-start gap-2">
                        <svg class="w-3.5 h-3.5 text-[#002366] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span>{f}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>

            <div class="px-6 sm:px-8 pb-6 sm:pb-8 pt-4 border-t border-slate-100 flex items-center justify-between">
              <span class="text-xs font-mono text-slate-500">
                {svc.packages.length} Opsi Paket
              </span>
              <a
                href={`/layanan/${svc.slug}/`}
                class="font-mono text-xs font-bold uppercase text-[#002366] group-hover:text-[#002366] bg-slate-100 group-hover:bg-[#00d4ff] group-hover:text-[#001845] py-2 px-4 rounded-lg flex items-center gap-1.5 transition-all shadow-sm"
              >
                <span>Pelajari Detail</span>
                <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Keunggulan & Mengapa Kami (Technical E-E-A-T) -->
  <section class="py-20 bg-white border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-5 space-y-6">
          <div class="font-mono text-xs uppercase text-[#002366] font-bold tracking-widest flex items-center gap-2">
            <span class="w-6 h-0.5 bg-[#002366]"></span>
            <span>NILAI UNGGUL KORPORASI</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#002366] tracking-tight leading-tight">
            Mengapa Perusahaan di Batam Memilih EO Batam Production?
          </h2>
          <p class="text-slate-600 text-sm leading-relaxed">
            Menyelenggarakan event di kawasan kepulauan seperti Batam memerlukan penguasaan tantangan spesifik: logistik antar-kawasan industri, dinamika angin dan pasang laut pesisir, hingga regulasi legalitas instansi lokal.
          </p>

          <div class="p-4 bg-slate-50 border border-slate-200 rounded-lg">
            <span class="font-mono text-xs font-bold text-[#002366] block mb-1">KEBIJAKAN KUALITAS:</span>
            <p class="text-xs text-slate-600">
              Kami tidak membagi konsentrasi dengan menyewakan alat secara eceran. Seluruh inventaris perangkat panggung, sound system line array, dan LED videotron kami dedikasikan penuh untuk kesuksesan event yang Anda percayakan.
            </p>
          </div>
        </div>

        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-6">
          
          <div class="p-6 bg-slate-50 border border-slate-200 rounded-lg">
            <div class="w-8 h-8 rounded bg-[#002366] text-[#00d4ff] font-mono font-bold text-xs flex items-center justify-center mb-4">
              01
            </div>
            <h3 class="text-base font-bold text-[#002366] mb-2">Konsultasi Tatap Muka Langsung</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Tim kami siap datang ke kantor perusahaan Anda di Batam Center, Nagoya, Mukakuning, Batu Ampar, atau Kabil untuk presentasi dan survey awal.
            </p>
          </div>

          <div class="p-6 bg-slate-50 border border-slate-200 rounded-lg">
            <div class="w-8 h-8 rounded bg-[#002366] text-[#00d4ff] font-mono font-bold text-xs flex items-center justify-center mb-4">
              02
            </div>
            <h3 class="text-base font-bold text-[#002366] mb-2">Sistem Satu Pintu (All-in-One)</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Panitia internal Anda bebas dari kerepotan mengoordinasikan puluhan vendor berbeda. Mulai dari MC, konsumsi, genset, hingga talent berada di satu komando.
            </p>
          </div>

          <div class="p-6 bg-slate-50 border border-slate-200 rounded-lg">
            <div class="w-8 h-8 rounded bg-[#002366] text-[#00d4ff] font-mono font-bold text-xs flex items-center justify-center mb-4">
              03
            </div>
            <h3 class="text-base font-bold text-[#002366] mb-2">Transparansi Estimasi RAB</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Rincian alokasi anggaran disusun secara transparan tanpa biaya tersembunyi, dapat disesuaikan dengan limit plafon budget divisi Anda.
            </p>
          </div>

          <div class="p-6 bg-slate-50 border border-slate-200 rounded-lg">
            <div class="w-8 h-8 rounded bg-[#002366] text-[#00d4ff] font-mono font-bold text-xs flex items-center justify-center mb-4">
              04
            </div>
            <h3 class="text-base font-bold text-[#002366] mb-2">Pengawalan Izin & Legalitas</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Dukungan penuh pengurusan surat izin keramaian Polresta Barelang dan pelaporan kepatuhan pajak hiburan BPRD Kota Batam secara resmi.
            </p>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- Alur Kerja 4 Langkah -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="font-mono text-xs uppercase text-[#002366] font-bold tracking-widest block mb-2">
          WORKFLOW PRESISI
        </span>
        <h2 class="text-3xl font-extrabold text-[#002366]">
          Tahapan Kerjasama yang Praktis dan Terukur
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <div class="bg-white p-6 rounded-lg border border-slate-200 relative">
          <div class="font-mono text-2xl font-black text-[#002366] mb-3">01</div>
          <h3 class="text-base font-bold text-[#002366] mb-2">Undang Konsultasi</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Hubungi kami via WhatsApp. Jadwalkan waktu pertemuan di kantor Anda atau tentukan jadwal survey lokasi bersama.
          </p>
        </div>

        <div class="bg-white p-6 rounded-lg border border-slate-200 relative">
          <div class="font-mono text-2xl font-black text-[#002366] mb-3">02</div>
          <h3 class="text-base font-bold text-[#002366] mb-2">Proposal & Rancangan RAB</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Kami kirimkan draf konsep kreatif tematik, pilihan venue alternatif, dan simulasi biaya terperinci sesuai plafon anggaran.
          </p>
        </div>

        <div class="bg-white p-6 rounded-lg border border-slate-200 relative">
          <div class="font-mono text-2xl font-black text-[#002366] mb-3">03</div>
          <h3 class="text-base font-bold text-[#002366] mb-2">Produksi & Gladi Resik</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Tim teknis melakukan safety loading peralatan, koordinasi perizinan kepolisian, dan gladi resik rundown sebelum acara dimulai.
          </p>
        </div>

        <div class="bg-white p-6 rounded-lg border border-slate-200 relative">
          <div class="font-mono text-2xl font-black text-[#002366] mb-3">04</div>
          <h3 class="text-base font-bold text-[#002366] mb-2">Eksekusi & Laporan</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Pelaksanaan acara tepat waktu di bawah show director profesional, diakhiri dengan penyerahan dokumentasi foto dan aftermovie.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- Artikel & Panduan Event (SEO Spoke Articles) -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <span class="font-mono text-xs uppercase text-[#002366] font-bold tracking-widest block mb-2">
            PUSAT PENGETAHUAN & PANDUAN
          </span>
          <h2 class="text-3xl font-extrabold text-[#002366]">
            Artikel Panduan Event Perusahaan di Batam
          </h2>
        </div>
        <a
          href="/blog/"
          class="mt-4 md:mt-0 font-mono text-xs font-bold uppercase text-[#002366] hover:text-[#00d4ff] flex items-center gap-1.5"
        >
          <span>Lihat Semua Artikel</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {sortedPosts.map((post) => (
          <article class="bg-slate-50 border border-slate-200 rounded-lg overflow-hidden flex flex-col justify-between hover:border-[#002366] hover:shadow-md transition-all">
            <!-- 4:3 Aspect Ratio Thumbnail -->
            <a href={`/blog/${post.id}/`} class="block aspect-[4/3] w-full overflow-hidden bg-slate-200 relative group">
              <img
                src={post.data.image || '/images/blog/default-blog.webp'}
                alt={post.data.title}
                width="800"
                height="600"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded bg-[#001845]/90 text-[#00d4ff] text-[10px] font-mono uppercase font-bold border border-[#00d4ff]/30">
                {post.data.category}
              </span>
            </a>

            <div class="p-6 flex-grow flex flex-col justify-between">
              <div>
                <span class="text-[11px] font-mono text-slate-400 block mb-2">
                  {post.data.publishDate.toISOString().split('T')[0]}
                </span>

                <h3 class="text-base font-bold text-[#002366] mb-2 leading-snug line-clamp-2">
                  <a href={`/blog/${post.id}/`} class="hover:underline">
                    {post.data.title}
                  </a>
                </h3>

                <p class="text-xs text-slate-600 leading-relaxed line-clamp-3">
                  {post.data.description}
                </p>
              </div>

              <div class="pt-4 mt-4 border-t border-slate-200/60 flex items-center justify-between text-xs font-mono">
                <a href="/author/zazuli/" class="text-slate-500 hover:text-[#002366] hover:underline">
                  {post.data.author}
                </a>
                <a
                  href={`/blog/${post.id}/`}
                  class="font-bold text-[#002366] hover:text-[#00d4ff] flex items-center gap-1"
                >
                  <span>Baca Panduan</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- Contact CTA Component -->
  <ContactCTA />
</BaseLayout>
