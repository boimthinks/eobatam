---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---

<BaseLayout
  title="Kontak Kami - EO Batam Production"
  description="Hubungi EO Batam Production untuk konsultasi rencana event kantor di Batam. Tim kami siap hadir langsung ke kantor Anda untuk presentasi proposal dan survey lokasi gratis."
  image="/images/pages/kontak.webp"
>
  <Breadcrumbs items={[{ name: 'Kontak' }]} />

  <!-- Page Header -->
  <section class="py-16 bg-[#002366] text-white bg-grid-blueprint-dark border-b-2 border-[#00d4ff]/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <span class="inline-block px-3 py-1 bg-white/10 text-[#00d4ff] font-mono text-xs uppercase tracking-wider rounded border border-[#00d4ff]/40">
          PUSAT LAYANAN & KONSULTASI
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight font-sans text-white">
          Hubungi EO Batam Production
        </h1>
        <p class="text-slate-200 text-sm sm:text-base leading-relaxed">
          Diskusikan rencana corporate gathering, seminar MICE, outbound, atau gala dinner Anda. Tim kami siap berkunjung langsung ke kantor Anda di seluruh wilayah Batam.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Cards with Position Counters 01 - 04 -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
        
        <!-- Counter 01: Address -->
        <div class="bg-white border-2 border-slate-200 p-6 rounded-lg shadow-sm space-y-3">
          <div class="w-8 h-8 rounded bg-[#002366] text-[#00d4ff] font-mono font-bold text-xs flex items-center justify-center">
            01
          </div>
          <span class="font-mono text-xs uppercase font-bold text-[#002366] block">
            KANTOR OPERASIONAL
          </span>
          <p class="text-xs text-slate-600 leading-relaxed font-sans">
            Ruko Mega Legenda 2<br/>
            Jln. Jend Sudirman Komp. Ruko Mega Legenda 2 Blok B2 No.7, Baloi Permai, Batam Kota, Batam, Kepulauan Riau 29431
          </p>
        </div>

        <!-- Counter 02: WhatsApp -->
        <div class="bg-white border-2 border-slate-200 p-6 rounded-lg shadow-sm space-y-3">
          <div class="w-8 h-8 rounded bg-[#002366] text-[#00d4ff] font-mono font-bold text-xs flex items-center justify-center">
            02
          </div>
          <span class="font-mono text-xs uppercase font-bold text-[#002366] block">
            WHATSAPP LANGSUNG
          </span>
          <p class="text-xs text-slate-600 leading-relaxed font-sans">
            Konsultasi cepat, kirim TOR/rundown, atau jadwalkan janji temu:
          </p>
          <a
            href="https://wa.me/6281373703639?text=Halo%20EO%20Batam%20Production,%20saya%20ingin%20konsultasi%20event%20perusahaan"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 font-mono text-xs font-bold text-[#0c3d9c] hover:underline"
          >
            0813-7370-3639
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>

        <!-- Counter 03: Email -->
        <div class="bg-white border-2 border-slate-200 p-6 rounded-lg shadow-sm space-y-3">
          <div class="w-8 h-8 rounded bg-[#002366] text-[#00d4ff] font-mono font-bold text-xs flex items-center justify-center">
            03
          </div>
          <span class="font-mono text-xs uppercase font-bold text-[#002366] block">
            EMAIL RESMI
          </span>
          <p class="text-xs text-slate-600 leading-relaxed font-sans">
            Pengiriman dokumen tender, permohonan proposal, dan berkas administrasi:
          </p>
          <a
            href="mailto:info@eobatam.web.id"
            class="inline-flex items-center gap-1.5 font-mono text-xs font-bold text-[#0c3d9c] hover:underline"
          >
            info@eobatam.web.id
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>

        <!-- Counter 04: Jam Kerja -->
        <div class="bg-white border-2 border-slate-200 p-6 rounded-lg shadow-sm space-y-3">
          <div class="w-8 h-8 rounded bg-[#002366] text-[#00d4ff] font-mono font-bold text-xs flex items-center justify-center">
            04
          </div>
          <span class="font-mono text-xs uppercase font-bold text-[#002366] block">
            JAM LAYANAN
          </span>
          <p class="text-xs text-slate-600 leading-relaxed font-sans">
            Senin s/d Sabtu:<br/>
            <strong>08.30 sampai 17.30 WIB</strong><br/>
            (Standby Koordinasi Event: 24 Jam)
          </p>
        </div>

      </div>

      <!-- Free Consultation Action Card -->
      <div class="bg-[#001845] text-white p-8 sm:p-12 rounded-2xl border-2 border-[#00d4ff]/40 shadow-2xl max-w-5xl mx-auto space-y-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <div class="lg:col-span-7 space-y-4 text-center lg:text-left">
            <span class="inline-block px-3 py-1 bg-white/10 text-[#00d4ff] font-mono text-xs uppercase tracking-wider rounded border border-[#00d4ff]/40">
              FREE ON-SITE CONSULTATION & SURVEY
            </span>
            <h2 class="text-2xl sm:text-3xl font-bold font-sans">
              Ingin Tim Kami Datang ke Kantor Anda di Batam?
            </h2>
            <p class="text-slate-300 text-sm leading-relaxed">
              Tentukan hari dan jam yang sesuai. Kami siap membawa sampel rundown, rekomendasi venue, dan simulasi alokasi anggaran langsung ke meja kerja Anda.
            </p>
            <div class="pt-2">
              <a
                href="https://wa.me/6281373703639?text=Halo%20EO%20Batam%20Production,%20kami%20ingin%20mengundang%20tim%20Anda%20ke%20kantor%20untuk%20konsultasi%20event"
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-sm uppercase font-bold px-8 py-4 rounded bg-[#00d4ff] text-[#001845] hover:bg-white hover:text-[#002366] transition-all inline-flex items-center gap-3 shadow-md"
              >
                <span>Jadwalkan Kunjungan Tim (WhatsApp)</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </a>
            </div>
          </div>

          <div class="lg:col-span-5">
            <div class="aspect-[4/3] w-full rounded-xl overflow-hidden border border-[#00d4ff]/30 shadow-lg relative bg-slate-900 group">
              <img
                src="/images/pages/kontak.webp"
                alt="Kantor & Konsultasi EO Batam Production"
                width="800"
                height="600"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="eager"
              />
            </div>
          </div>

        </div>
      </div>

    </div>
  </section>
</BaseLayout>
