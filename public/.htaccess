# ==============================================================================
# .htaccess untuk Astro Static Site (SSG) di cPanel / Shared Hosting DomaiNesia
# EO Batam Production (eobatam.web.id)
# ==============================================================================

# 1. Nonaktifkan Directory Listing
Options -Indexes

# 2. Aktifkan Modul Rewrite
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------
  # A. Paksa HTTPS (SSL)
  # ----------------------------------------------------------------------
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # ----------------------------------------------------------------------
  # B. Standarisasi Non-WWW (eobatam.web.id)
  # ----------------------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^www\.eobatam\.web\.id$ [NC]
  RewriteRule ^(.*)$ https://eobatam.web.id/$1 [R=301,L]

  # ----------------------------------------------------------------------
  # C. Paksa Trailing Slash pada Direktori / URL Halaman
  #    Kecuali jika file fisik ada (gambar, css, js, dsb)
  # ----------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(.[a-zA-Z0-9]{1,5})$
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1/ [R=301,L]
</IfModule>

# ------------------------------------------------------------------------------
# 3. Optimasi Kompresi Gzip / Brotli (Meningkatkan PageSpeed & Skor Core Web Vitals)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# 4. Browser Caching (Expires Headers untuk Aset Statis)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Gambar (WebP, PNG, SVG, Favicon) disimpan 1 tahun
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # CSS dan JS dengan content-hash Astro disimpan 1 tahun
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # HTML & XML (Sitemap/Feeds) cache singkat agar update konten segera terbaca
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

# ------------------------------------------------------------------------------
# 5. Header Keamanan Dasar (Security Headers)
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Cegah clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"
  # Cegah MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"
  # Referrer policy untuk privasi & analytics aman
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Proteksi XSS peramban lama
  Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# ------------------------------------------------------------------------------
# 6. Halaman Error 404 Kustom (Halaman statis dari dist/404.html)
# ------------------------------------------------------------------------------
ErrorDocument 404 /404.html
